rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Disallow root collection access
    match /{document=**} {
      allow read, write: if false;
    }

    // User document and all subcollections isolated strictly by Firebase Authentication UID
    match /users/{userId} {
      // User can only read and write their own profile document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcollections: reminders, events, studySessions, completionRecords, achievements, settings, streak
      match /reminders/{reminderId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /events/{eventId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /studySessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /completionRecords/{recordId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /achievements/{achievementId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /settings/{settingDoc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /streak/{streakDoc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
